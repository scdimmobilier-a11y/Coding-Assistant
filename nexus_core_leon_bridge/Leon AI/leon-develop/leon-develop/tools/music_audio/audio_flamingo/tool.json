{
  "$schema": "../../../schemas/tool-schemas/tool.json",
  "tool_id": "audio_flamingo",
  "toolkit_id": "music_audio",
  "name": "Audio Flamingo 3",
  "description": "NVIDIA's Audio Flamingo 3 (nvidia/audio-flamingo-3-hf), a large audio-language model that transcribes speech and, unlike plain ASR, can also describe and answer free-form questions about non-speech sound: sound events, music, mood, ambience. Non-commercial research use only (NVIDIA OneWay Noncommercial License + Qwen Research License).",
  "icon_name": "ear-line",
  "author": {
    "name": "Nexus Assistant integration",
    "url": "https://huggingface.co/nvidia/audio-flamingo-3-hf"
  },
  "functions": {
    "transcribeAudio": {
      "description": "Transcribe speech in an audio file to text using Audio Flamingo 3.",
      "parameters": {
        "type": "object",
        "properties": {
          "tasks": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "audio_path": { "type": "string" },
                  "output_path": { "type": "string" }
                },
                "required": ["audio_path", "output_path"],
                "additionalProperties": false
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "audio_path": { "type": "string" },
                    "output_path": { "type": "string" }
                  },
                  "required": ["audio_path", "output_path"],
                  "additionalProperties": false
                }
              }
            ]
          },
          "device": { "type": "string", "description": "cpu | cuda | auto" }
        },
        "required": ["tasks"]
      }
    },
    "understandAudio": {
      "description": "Answer a free-form question about an audio clip using Audio Flamingo 3 — sound events, music, mood, ambience, or 'what is this sound', not just speech transcription.",
      "parameters": {
        "type": "object",
        "properties": {
          "tasks": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "audio_path": { "type": "string" },
                  "question": {
                    "type": "string",
                    "description": "Defaults to 'Describe what you hear in this audio in detail.' if omitted."
                  },
                  "output_path": { "type": "string" },
                  "enable_thinking": {
                    "type": "boolean",
                    "description": "Ask AF3 to reason step by step before answering."
                  }
                },
                "required": ["audio_path"],
                "additionalProperties": false
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "audio_path": { "type": "string" },
                    "question": { "type": "string" },
                    "output_path": { "type": "string" },
                    "enable_thinking": { "type": "boolean" }
                  },
                  "required": ["audio_path"],
                  "additionalProperties": false
                }
              }
            ]
          },
          "device": { "type": "string", "description": "cpu | cuda | auto" }
        },
        "required": ["tasks"]
      }
    }
  }
}
